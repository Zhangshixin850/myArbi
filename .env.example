# Copy to .env. Keep credentials only on the server.
APP_USER=admin
APP_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=sqlite:///data/arbi.db
POLL_SECONDS=60
STALE_SECONDS=180
SNAPSHOT_RETENTION_DAYS=30
IMBALANCE_RATIO=0.01
MAX_LEVERAGE=5
MAX_MARGIN_USAGE=0.7
MIN_LIQUIDATION_DISTANCE=0.1
# Standard Binance account only; no portfolio/multi-assets margin in v1.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Aster Pro API V3 agent (never use the main wallet private key)
ASTER_USER=
ASTER_SIGNER=
ASTER_PRIVATE_KEY=
SITE_ADDRESS=localhost
